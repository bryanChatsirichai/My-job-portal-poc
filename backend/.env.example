# Copy to backend/.env:  cp .env.example .env
# Loaded automatically by worker, API, and Alembic (see app/config.py).
# Restart uvicorn and re-run worker after changing DATABASE_URL.

# --- Database (pick one) ---
# Single switch for worker sync, GET /api/v1/jobs, and GET /api/v1/health (reports "sqlite" or "postgres").

# SQLite — default POC, no Docker
DATABASE_URL=sqlite:///./jobportal.db

# Postgres — start container first (see backend/docker/postgres/.env.example), then uncomment:
# DATABASE_URL=postgresql+psycopg2://jobportal:jobportal@localhost:5432/jobportal
# User, password, port, and db name must match backend/docker/postgres/.env

# --- Core ---
CORS_ORIGINS=http://localhost:5173
SYNC_CRON_SCHEDULE=0 2 * * *

# --- Job sources (set *_ENABLED=false to skip during --sync) ---
MCF_ENABLED=true
JOBICY_ENABLED=true
ADZUNA_ENABLED=true
LINKEDIN_ENABLED=true
JOBSPY_ENABLED=true

# Jobs fetched per API page during --sync
MCF_PAGE_SIZE=100
ADZUNA_PAGE_SIZE=50
JOBICY_PAGE_SIZE=200
LINKEDIN_PAGE_SIZE=70
JOBSPY_PAGE_SIZE=1

# Max pages (JobSpy: search terms) per --sync. Remove a line for unlimited on that source.
# Limited sync may mark unfetched jobs expired — delete all *_MAX_PAGES for a full catalog.
MCF_MAX_PAGES=2
ADZUNA_MAX_PAGES=2
JOBICY_MAX_PAGES=2
LINKEDIN_MAX_PAGES=2
JOBSPY_MAX_PAGES=2

# --- Jobicy (optional filters, no API key) — https://jobicy.com/jobs-rss-feed ---
# JOBICY_GEO=singapore
# JOBICY_INDUSTRY=engineering
# JOBICY_TAG=python

# --- Adzuna (optional, free key) — https://developer.adzuna.com ---
# Leave blank to skip Adzuna during sync.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- LinkedIn (optional self-hosted scraper) — https://github.com/atharv01h/Linkedin-Jobs-Api ---
# Run the Node service on localhost:3000 first, or set LINKEDIN_ENABLED=false.
LINKEDIN_JOBS_API_URL=http://localhost:3000/api/v1
LINKEDIN_LOCATION=Singapore
# LINKEDIN_KEYWORDS=software engineer
# LINKEDIN_DATE_SINCE_POSTED=past_week

# --- JobSpy (optional self-hosted scraper sidecar) ---
# Start: cd D:\Projects\JobSpy && uv run uvicorn jobspy_api.main:app --port 8001
JOBSPY_API_URL=http://localhost:8001/v1

# --- Auth (Phase 2, not wired yet) ---
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60
