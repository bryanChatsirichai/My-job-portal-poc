# Copy to .env in this directory:  cp .env.example .env
# Used by docker-compose.yml only — not read by FastAPI.
#
# Start:  docker compose up -d   (from backend/docker/postgres/)
#
# Then set DATABASE_URL in backend/.env to match these values:
#   postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_HOST_PORT>/<POSTGRES_DB>

POSTGRES_USER=jobportal
POSTGRES_PASSWORD=jobportal
POSTGRES_DB=jobportal
POSTGRES_HOST_PORT=5432
